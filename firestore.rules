rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: youth_profiles
// Document ID: {profileId} (UUID or auto-generated ID)
// Fields:
//   - Barangay / barangay: string (required, 1-100 chars) - Assigned Barangay
//   - Full Name / fullName / name: string (required, 1-150 chars) - Youth full name
//   - Sex: string (optional, max 30 chars) - Biological sex / gender
//   - Date of Birth: string/timestamp (optional) - Birthdate
//   - Civil Status: string (optional, max 50 chars) - Civil status
//   - Contact Number: string (optional, max 50 chars) - Phone / contact
//   - Sitio/Purok: string (optional, max 100 chars) - Sub-barangay territory
//   - Tribe: string (optional, max 100 chars) - Ethnic affiliation
//   - Educational Status: string (optional, max 100 chars) - e.g. In-School / OSY
//   - Highest Educational Attainment: string (optional, max 100 chars)
//   - Employment Status: string (optional, max 100 chars) - e.g. Employed / Student
//   - Youth Sector: string (optional, max 100 chars) - Specific demographic sector
//
// Collection: online_submissions
// Document ID: {submissionId} (auto-generated ID)
// Fields:
//   - Barangay / barangay: string (required, 1-100 chars) - Target Barangay
//   - Full Name / fullName: string (required, 1-150 chars) - Applicant full name
//   - Contact Number / contactNumber: string (optional, max 50 chars)
//   - Sitio/Purok / sitio: string (optional, max 100 chars)
//
// Collection: users
// Document ID: {userId} (auto-generated ID or matches Firebase Auth UID)
// Fields:
//   - username: string (optional, max 100 chars) - Account username
//   - passwordHash: string (optional, max 200 chars) - Hashed password
//   - password: string (optional, max 200 chars) - Legacy password string
//   - email: string (optional, max 150 chars) - Account email
//   - role: string (optional, max 50 chars) - 'Admin' or 'Barangay User'
//   - barangay / Barangay: string (optional, max 100 chars) - Jurisdiction
//   - createdAt: timestamp/string (optional) - Registration timestamp
//
// Collection: audit_logs
// Document ID: {logId} (auto-generated ID)
// Fields:
//   - action / Action: string (optional, max 50 chars) - Event action (e.g., LOGIN, EDIT, DELETE)
//   - recordName: string (optional, max 200 chars) - Target record name or description
//   - details / Details: string (optional, max 2000 chars) - Change details / diff
//   - barangay / Barangay: string (optional, max 100 chars) - Operator/record barangay
//   - user / User: string (optional, max 100 chars) - Operator username / UID
//   - timestamp / Timestamp: timestamp/string (optional) - Event occurrence time
//
// Collection: counters
// Document ID: {counterId} (e.g., barangay-year sequence identifier)
// Fields:
//   - lastSerial: int/number (required, >= 0) - Latest sequential serial counter
//   - barangay / Barangay: string (optional, max 100 chars) - Associated barangay
//   - year: string/int/number (optional) - Year identifier
//   - prefix: string (optional, max 50 chars) - Sequence prefix (e.g., SK-Mal)
//   - updatedAt / timestamp: timestamp/string (optional) - Last update time
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated Firebase Auth user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user has the Admin role in custom claims
    function isAdmin() {
      return isAuthenticated() &&
             'role' in request.auth.token &&
             request.auth.token.role == 'Admin';
    }

    // ===============================================================
    // Domain Validators (Validator Function Pattern)
    // ===============================================================

    // Validate barangay field existence, type, and bounded length
    function hasValidBarangay(data) {
      return ('Barangay' in data && data['Barangay'] is string && data['Barangay'].size() > 0 && data['Barangay'].size() <= 100) ||
             ('barangay' in data && data['barangay'] is string && data['barangay'].size() > 0 && data['barangay'].size() <= 100);
    }

    // Validate youth / registrant full name field
    function hasValidName(data) {
      return ('Full Name' in data && data['Full Name'] is string && data['Full Name'].size() > 0 && data['Full Name'].size() <= 150) ||
             ('fullName' in data && data['fullName'] is string && data['fullName'].size() > 0 && data['fullName'].size() <= 150) ||
             ('name' in data && data['name'] is string && data['name'].size() > 0 && data['name'].size() <= 150);
    }

    // Domain validator for youth profile documents
    function isValidYouthProfile(data) {
      return hasValidBarangay(data) &&
             hasValidName(data) &&
             (!('Sex' in data) || (data['Sex'] is string && data['Sex'].size() <= 30)) &&
             (!('Civil Status' in data) || (data['Civil Status'] is string && data['Civil Status'].size() <= 50)) &&
             (!('Contact Number' in data) || (data['Contact Number'] is string && data['Contact Number'].size() <= 50)) &&
             (!('Sitio/Purok' in data) || (data['Sitio/Purok'] is string && data['Sitio/Purok'].size() <= 100)) &&
             (!('Tribe' in data) || (data['Tribe'] is string && data['Tribe'].size() <= 100)) &&
             (!('Educational Status' in data) || (data['Educational Status'] is string && data['Educational Status'].size() <= 100)) &&
             (!('Employment Status' in data) || (data['Employment Status'] is string && data['Employment Status'].size() <= 100)) &&
             (!('Youth Sector' in data) || (data['Youth Sector'] is string && data['Youth Sector'].size() <= 100)) &&
             (!('Date of Birth' in data) || (data['Date of Birth'] is string || data['Date of Birth'] is timestamp)) &&
             (!('ageBracket' in data) || (data.ageBracket is string && data.ageBracket.size() <= 50));
    }

    // Domain validator for public online intake submissions
    function isValidOnlineSubmission(data) {
      return hasValidBarangay(data) &&
             hasValidName(data) &&
             (!('Contact Number' in data) || (data['Contact Number'] is string && data['Contact Number'].size() <= 50)) &&
             (!('contactNumber' in data) || (data['contactNumber'] is string && data['contactNumber'].size() <= 50)) &&
             (!('Sitio/Purok' in data) || (data['Sitio/Purok'] is string && data['Sitio/Purok'].size() <= 100)) &&
             (!('sitio' in data) || (data['sitio'] is string && data['sitio'].size() <= 100));
    }

    // Domain validator for user documents
    function isValidUser(data) {
      return (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             (!('barangay' in data) || (data.barangay is string && data.barangay.size() <= 100)) &&
             (!('Barangay' in data) || (data.Barangay is string && data.Barangay.size() <= 100)) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 200)) &&
             (!('password' in data) || (data.password is string && data.password.size() <= 200)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string));
    }

    // Domain validator for audit log entries
    function isValidAuditLog(data) {
      return (!('action' in data) || (data.action is string && data.action.size() <= 50)) &&
             (!('Action' in data) || (data.Action is string && data.Action.size() <= 50)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000)) &&
             (!('Details' in data) || (data.Details is string && data.Details.size() <= 2000)) &&
             (!('barangay' in data) || (data.barangay is string && data.barangay.size() <= 100)) &&
             (!('Barangay' in data) || (data.Barangay is string && data.Barangay.size() <= 100)) &&
             (!('user' in data) || (data.user is string && data.user.size() <= 100)) &&
             (!('User' in data) || (data.User is string && data.User.size() <= 100)) &&
             (!('recordName' in data) || (data.recordName is string && data.recordName.size() <= 200)) &&
             (!('timestamp' in data) || (data.timestamp is timestamp || data.timestamp is string));
    }

    // Domain validator for atomic sequence counters (Form Numbers)
    function isValidCounter(data) {
      return ('lastSerial' in data) &&
             (data.lastSerial is int || data.lastSerial is number) &&
             data.lastSerial >= 0 &&
             (!('barangay' in data) || (data.barangay is string && data.barangay.size() <= 100)) &&
             (!('Barangay' in data) || (data.Barangay is string && data.Barangay.size() <= 100)) &&
             (!('year' in data) || (data.year is string && data.year.size() <= 10) || (data.year is int || data.year is number)) &&
             (!('prefix' in data) || (data.prefix is string && data.prefix.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string)) &&
             (!('timestamp' in data) || (data.timestamp is timestamp || data.timestamp is string));
    }

    // ===============================================================
    // 1. Master Collection: youth_profiles
    // ===============================================================
    match /youth_profiles/{profileId} {
      // Read: Allow all users (supports both Firebase Auth and custom username/password session logins)
      allow read: if true;

      // Create: Allow if authenticated OR if payload passes valid youth profile & barangay validation
      allow create: if isAuthenticated() || isValidYouthProfile(request.resource.data);

      // Update: Allow if authenticated OR if updated payload passes youth profile & barangay validation
      allow update: if isAuthenticated() || isValidYouthProfile(request.resource.data);

      // Delete: Allow authenticated users or all users during initial rollout
      allow delete: if isAuthenticated() || true;
    }

    // ===============================================================
    // 2. Public Intake Collection: online_submissions (eProfiling)
    // ===============================================================
    match /online_submissions/{submissionId} {
      // Public / unauthenticated self-registration: anyone can submit with valid required fields
      allow create: if isValidOnlineSubmission(request.resource.data);

      // Allow intake reading, processing, and batch synchronization
      allow read, delete: if isAuthenticated() || true;
      allow update: if (isAuthenticated() || true) && isValidOnlineSubmission(request.resource.data);
    }

    // ===============================================================
    // 3. User Profiles Collection: users
    // ===============================================================
    match /users/{userId} {
      // Anyone can read user accounts to allow user lookup by username on login
      allow read: if true;

      // Anyone can create user accounts with validation for self-registration of barangay accounts
      allow create: if isValidUser(request.resource.data);

      // Update and delete remain restricted to isAdmin() or the account owner
      allow update: if (isAdmin() || (isAuthenticated() && request.auth.uid == userId)) &&
                       isValidUser(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // ===============================================================
    // 4. System Audit Trail: audit_logs
    // ===============================================================
    match /audit_logs/{logId} {
      // Read: Allow all users to inspect system audit trail and dashboard feeds
      allow read: if true;

      // Create/Update: Allow if authenticated OR if payload conforms to valid audit log schema
      allow create, update: if isAuthenticated() || isValidAuditLog(request.resource.data);

      // Delete: Allow authenticated users or all users during initial rollout
      allow delete: if isAuthenticated() || true;
    }

    // ===============================================================
    // 5. Atomic Sequence Counters: counters
    // ===============================================================
    match /counters/{counterId} {
      // Allow unauthenticated and authenticated clients to read and update
      // so atomic transactions from public web forms (prof.js) can increment lastSerial
      allow read: if true;
      allow create, update: if isValidCounter(request.resource.data);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Default Deny Rule
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
