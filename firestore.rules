rules_version = '2';

// ===============================================================
// Assumed Data Model (SKYMS - Malungon, Sarangani Province)
// ===============================================================
//
// Collection: youth_profiles
// Document ID: {profileId} (UUID or auto-generated ID)
// Fields:
//   - Barangay: string (required, 1-100 chars) - Assigned Barangay
//   - Full Name: string (required, 1-150 chars) - Youth full name
//   - Timestamp, Date of Birth, Date Accomplished, Date Received, approvedAt, updatedAt, createdAt, submittedAt: timestamp or string (optional, <= 150 chars)
//   - createdBy, updatedBy: string or null (optional, <= 150 chars)
//   - Age: int/float (0-120), string (<= 30 chars), or null (optional)
//   - calculatedAge: int/float (0-120) or null (optional)
//   - Total Household Members: int/float (0-100), string (<= 50 chars), or null (optional)
//   - Multi-select / goals / address strings: string (optional, <= 2000 chars)
//   - Standard survey & system strings: string (optional, <= 250 chars)
//
// Collection: online_submissions
// Document ID: {submissionId} (auto-generated ID)
// Fields:
//   - Barangay / barangay: string (at least one required, 1-100 chars) - Target Barangay
//   - Full Name / fullName: string (at least one required, 1-150 chars) - Applicant full name
//   - Survey fields (TitleCase matching youth_profiles, excluding approvedAt) and camelCase intake keys
//   - Forbidden fields: approvedAt, role, status, isApproved, password, passwordHash
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - uid: string (required on create, == userId, <= 128 chars)
//   - username: string (required on create, 1-100 chars)
//   - email: string (required on create, 1-150 chars)
//   - fullName: string (optional, <= 150 chars)
//   - displayName: string or null (optional, <= 150 chars)
//   - photoURL: string (http/https URL or empty) or null (optional, <= 500 chars)
//   - contactNumber: string or null (optional, <= 50 chars)
//   - role: string (required on create: 'Barangay User'; admin update: 'Admin' or 'Barangay User')
//   - barangay: string (required on create: 1-100 chars, not 'All' or 'System Admin')
//   - status: string (required on create: 'Pending'; admin update: 'Pending'|'Approved'|'Rejected'|'Deactivated')
//   - isApproved: bool (required on create: false)
//   - authProvider: string (required on create: 'google' or 'password')
//   - approvedBy / rejectedBy: string or null (optional, <= 100 chars)
//   - approvedAt / rejectedAt / createdAt / updatedAt: timestamp, string (<= 100 chars), or null (optional)
//   - Forbidden fields: password, passwordHash
//
// Collection: audit_logs (immutable)
// Document ID: {logId} (auto-generated ID)
// Fields:
//   - action: string (required, 1-50 chars)
//   - recordName: string (required, 1-200 chars)
//   - details: string (required, <= 2000 chars)
//   - barangay: string (required, 1-100 chars)
//   - user: string (required, 1-100 chars)
//   - timestamp: timestamp or string (required, 1-100 chars)
//
// Collection: counters
// Document ID: {counterId}
// Fields:
//   - lastSerial: int (required, >= 0)
//   - barangay / Barangay: string (optional, <= 100 chars)
//   - year: int (2000-2100) or string (optional, <= 10 chars)
//   - prefix: string (optional, <= 50 chars)
//   - updatedAt / timestamp: timestamp or string (optional, <= 100 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Authentication & Jurisdiction Helpers
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isAuthenticated() && exists(userDocPath());
    }

    function currentUser() {
      return get(userDocPath()).data;
    }

    function isApprovedUser() {
      return userExists() &&
             'status' in currentUser() &&
             (currentUser().status == 'Approved' || currentUser().status == 'approved' || currentUser().status == 'Active') &&
             'isApproved' in currentUser() &&
             (currentUser().isApproved == true || currentUser().isApproved == 'true');
    }

    function isAdmin() {
      return isAuthenticated() &&
             (('token' in request.auth && 'role' in request.auth.token && request.auth.token.role == 'Admin') ||
              (isApprovedUser() &&
               'role' in currentUser() &&
               (currentUser().role == 'Admin' || currentUser().role == 'admin' || currentUser().role == 'System Admin' || currentUser().role == 'Administrator')));
    }

    function userBarangay() {
      return userExists() && 'barangay' in currentUser() ? currentUser().barangay : '';
    }

    function canAccessBarangay(brgy) {
      return isAuthenticated() &&
             brgy is string &&
             (isAdmin() ||
              (isApprovedUser() && (userBarangay() == 'All' || brgy == userBarangay())));
    }

    // ===============================================================
    // Optimized Field Validators (AST-Budget Protected)
    // ===============================================================

    function isShortStr(val) {
      return val == null || (val is string && val.size() <= 250);
    }

    function isLongStr(val) {
      return val == null || (val is string && val.size() <= 2000);
    }

    function isDateVal(val) {
      return val == null || (val is string && val.size() <= 150) || val is timestamp;
    }

    function isAgeVal(val) {
      return val == null ||
             (val is int && val >= 0 && val <= 120) ||
             (val is float && val >= 0.0 && val <= 120.0) ||
             (val is string && val.size() <= 30);
    }

    function isCalcAgeVal(val) {
      return val == null ||
             (val is int && val >= 0 && val <= 120) ||
             (val is float && val >= 0.0 && val <= 120.0);
    }

    function isHouseholdMembersVal(val) {
      return val == null ||
             (val is int && val >= 0 && val <= 100) ||
             (val is float && val >= 0.0 && val <= 100.0) ||
             (val is string && val.size() <= 50);
    }

    function isValidUrl(url) {
      return url is string &&
             (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    function isOptionalPhotoUrl(data, key) {
      return !(key in data) ||
             data[key] == null ||
             data[key] == '' ||
             (isValidUrl(data[key]) && data[key].size() <= 1000);
    }

    // Survey Field Validation across all 45 demographic fields
    function hasValidSurveyFields(d) {
      return isDateVal(d.get('Timestamp', null)) &&
             isShortStr(d.get('FormNo.', null)) &&
             isShortStr(d.get('Nickname', null)) &&
             isShortStr(d.get('Sex', null)) &&
             isDateVal(d.get('Date of Birth', null)) &&
             isAgeVal(d.get('Age', null)) &&
             isCalcAgeVal(d.get('calculatedAge', null)) &&
             isShortStr(d.get('ageBracket', null)) &&
             isShortStr(d.get('Place of Birth', null)) &&
             isShortStr(d.get('Civil Status', null)) &&
             isShortStr(d.get('Tribe', null)) &&
             isShortStr(d.get('Citizenship', null)) &&
             isShortStr(d.get('Religion', null)) &&
             isShortStr(d.get('Sitio/Purok', null)) &&
             isLongStr(d.get('Complete Address', null)) &&
             isShortStr(d.get('Contact Number', null)) &&
             isShortStr(d.get('Email Address', null)) &&
             isShortStr(d.get('Educational Status', null)) &&
             isShortStr(d.get('Highest Educational Attainment', null)) &&
             isShortStr(d.get('School/Institution', null)) &&
             isShortStr(d.get('Course/Strand', null)) &&
             isShortStr(d.get('Employment Status', null)) &&
             isShortStr(d.get('Nature of Work', null)) &&
             isLongStr(d.get('Skills/Talents', null)) &&
             isLongStr(d.get('Languages Spoken', null)) &&
             isShortStr(d.get('Member of Youth Organization', null)) &&
             isLongStr(d.get('Organizations', null)) &&
             isLongStr(d.get('Leadership Position', null)) &&
             isLongStr(d.get('Volunteer Activities', null)) &&
             isLongStr(d.get('Areas of Interest', null)) &&
             isLongStr(d.get('Youth Sector', null)) &&
             isHouseholdMembersVal(d.get('Total Household Members', null)) &&
             isShortStr(d.get('Household Income', null)) &&
             isShortStr(d.get('Internet Access', null)) &&
             isShortStr(d.get('Internet Connection Type', null)) &&
             isLongStr(d.get('Preferred Announcement Mode', null)) &&
             isLongStr(d.get('5-Year Goals', null)) &&
             isLongStr(d.get('Desired Programs', null)) &&
             isLongStr(d.get('Participation Mode', null)) &&
             isLongStr(d.get('Data Consent', null)) &&
             isDateVal(d.get('Date Accomplished', null)) &&
             isShortStr(d.get('SK Data Collector', null)) &&
             isDateVal(d.get('Date Received', null)) &&
             isShortStr(d.get('uid', null)) &&
             (!('updatedAt' in d) || isDateVal(d.updatedAt)) &&
             (!('approvedAt' in d) || isDateVal(d.approvedAt)) &&
             (!('createdAt' in d) || isDateVal(d.createdAt)) &&
             (!('submittedAt' in d) || isDateVal(d.submittedAt)) &&
             (!('createdBy' in d) || isShortStr(d.createdBy)) &&
             (!('updatedBy' in d) || isShortStr(d.updatedBy));
    }

    function youthProfileKeys() {
      return [
        'Timestamp', 'FormNo.', 'Barangay', 'Full Name', 'Nickname', 'Sex',
        'Date of Birth', 'Age', 'calculatedAge', 'ageBracket', 'Place of Birth',
        'Civil Status', 'Tribe', 'Citizenship', 'Religion', 'Sitio/Purok',
        'Complete Address', 'Contact Number', 'Email Address', 'Educational Status',
        'Highest Educational Attainment', 'School/Institution', 'Course/Strand',
        'Employment Status', 'Nature of Work', 'Skills/Talents', 'Languages Spoken',
        'Member of Youth Organization', 'Organizations', 'Leadership Position',
        'Volunteer Activities', 'Areas of Interest', 'Youth Sector',
        'Total Household Members', 'Household Income', 'Internet Access',
        'Internet Connection Type', 'Preferred Announcement Mode', '5-Year Goals',
        'Desired Programs', 'Participation Mode', 'Data Consent',
        'Date Accomplished', 'SK Data Collector', 'Date Received',
        'uid', 'approvedAt', 'updatedAt',
        'createdAt', 'submittedAt', 'createdBy', 'updatedBy'
      ];
    }

    function isValidYouthProfile(data) {
      return data.keys().hasOnly(youthProfileKeys()) &&
             isShortStr(data.get('Barangay', '')) &&
             data.Barangay.size() > 0 &&
             isShortStr(data.get('Full Name', '')) &&
             data['Full Name'].size() > 0 &&
             hasValidSurveyFields(data);
    }

    function isValidYouthProfileUpdate(data, affected) {
      return affected.hasOnly(youthProfileKeys()) &&
             isShortStr(data.get('Barangay', '')) &&
             data.Barangay.size() > 0 &&
             isShortStr(data.get('Full Name', '')) &&
             data['Full Name'].size() > 0 &&
             (!('createdAt' in resource.data) || !('createdAt' in affected)) &&
             (!('createdBy' in resource.data) || !('createdBy' in affected)) &&
             hasValidSurveyFields(data);
    }

    function onlineSubmissionKeys() {
      return [
        'Timestamp', 'FormNo.', 'Barangay', 'Full Name', 'Nickname', 'Sex',
        'Date of Birth', 'Age', 'calculatedAge', 'ageBracket', 'Place of Birth',
        'Civil Status', 'Tribe', 'Citizenship', 'Religion', 'Sitio/Purok',
        'Complete Address', 'Contact Number', 'Email Address', 'Educational Status',
        'Highest Educational Attainment', 'School/Institution', 'Course/Strand',
        'Employment Status', 'Nature of Work', 'Skills/Talents', 'Languages Spoken',
        'Member of Youth Organization', 'Organizations', 'Leadership Position',
        'Volunteer Activities', 'Areas of Interest', 'Youth Sector',
        'Total Household Members', 'Household Income', 'Internet Access',
        'Internet Connection Type', 'Preferred Announcement Mode', '5-Year Goals',
        'Desired Programs', 'Participation Mode', 'Data Consent',
        'Date Accomplished', 'SK Data Collector', 'Date Received',
        'uid', 'updatedAt',
        'barangay', 'fullName', 'contactNumber', 'sitio', 'dateOfBirth',
        'sex', 'civilStatus', 'tribe', 'educationalStatus',
        'highestEducationalAttainment', 'employmentStatus', 'youthSector',
        'formNo', 'createdAt', 'submittedAt'
      ];
    }

    function isValidOnlineSubmission(data) {
      return !data.keys().hasAny(['approvedAt', 'role', 'status', 'isApproved', 'password', 'passwordHash']) &&
             data.keys().hasOnly(onlineSubmissionKeys()) &&
             (('Barangay' in data && isShortStr(data.Barangay) && data.Barangay.size() > 0) ||
              ('barangay' in data && isShortStr(data.barangay) && data.barangay.size() > 0)) &&
             (('Full Name' in data && isShortStr(data['Full Name']) && data['Full Name'].size() > 0) ||
              ('fullName' in data && isShortStr(data.fullName) && data.fullName.size() > 0)) &&
             hasValidSurveyFields(data) &&
             (!('sitio' in data) || isShortStr(data.sitio)) &&
             (!('dateOfBirth' in data) || isDateVal(data.dateOfBirth)) &&
             (!('formNo' in data) || isShortStr(data.formNo));
    }

    function isValidUserProfileFields(data) {
      return (!('fullName' in data) || isShortStr(data.fullName)) &&
             (!('displayName' in data) || isShortStr(data.displayName)) &&
             (!('contactNumber' in data) || isShortStr(data.contactNumber)) &&
             isOptionalPhotoUrl(data, 'photoURL') &&
             (!('updatedAt' in data) || isDateVal(data.updatedAt));
    }

    function isValidNewUser(data, userId) {
      return data.keys().hasOnly([
               'uid', 'username', 'email', 'fullName', 'displayName', 'photoURL',
               'contactNumber', 'role', 'barangay', 'status', 'isApproved',
               'authProvider', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasAll([
               'uid', 'username', 'email', 'role', 'barangay',
               'status', 'isApproved', 'authProvider'
             ]) &&
             data.uid == userId &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role == 'Barangay User' &&
             data.status == 'Pending' &&
             data.isApproved == false &&
             data.barangay is string && data.barangay.size() > 0 &&
             data.barangay != 'All' && data.barangay != 'System Admin' &&
             data.authProvider in ['google', 'password'] &&
             isValidUserProfileFields(data) &&
             (!('createdAt' in data) || isDateVal(data.createdAt));
    }

    function isValidAdminUserUpdate(data) {
      return !data.keys().hasAny(['password', 'passwordHash']) &&
             data.keys().hasOnly([
               'uid', 'username', 'email', 'fullName', 'displayName', 'photoURL',
               'contactNumber', 'role', 'barangay', 'status', 'isApproved',
               'authProvider', 'approvedBy', 'approvedAt', 'rejectedBy',
               'rejectedAt', 'createdAt', 'updatedAt'
             ]) &&
             (!('uid' in resource.data) || !('uid' in data) || data.uid == resource.data.uid) &&
             (!('role' in data) || data.role in ['Admin', 'Barangay User']) &&
             (!('status' in data) || data.status in ['Pending', 'Approved', 'Rejected', 'Deactivated']) &&
             (!('isApproved' in data) || data.isApproved is bool) &&
             (!('barangay' in data) || (data.barangay is string && data.barangay.size() > 0)) &&
             (!('approvedBy' in data) || isShortStr(data.approvedBy)) &&
             (!('approvedAt' in data) || isDateVal(data.approvedAt)) &&
             (!('rejectedBy' in data) || isShortStr(data.rejectedBy)) &&
             (!('rejectedAt' in data) || isDateVal(data.rejectedAt)) &&
             (!('createdAt' in resource.data) || !('createdAt' in data) || data.createdAt == resource.data.createdAt) &&
             isValidUserProfileFields(data);
    }

    function isValidAuditLog(data) {
      return data.keys().hasOnly(['action', 'recordName', 'details', 'barangay', 'user', 'timestamp']) &&
             data.keys().hasAll(['action', 'recordName', 'details', 'barangay', 'user', 'timestamp']) &&
             isShortStr(data.action) && data.action.size() > 0 &&
             isShortStr(data.recordName) && data.recordName.size() > 0 &&
             isLongStr(data.details) &&
             isShortStr(data.barangay) && data.barangay.size() > 0 &&
             isShortStr(data.user) && data.user.size() > 0 &&
             isDateVal(data.timestamp);
    }

    function isValidCounter(data) {
      return data.keys().hasOnly(['lastSerial', 'barangay', 'Barangay', 'year', 'prefix', 'updatedAt', 'timestamp']) &&
             'lastSerial' in data && data.lastSerial is int && data.lastSerial >= 0 &&
             (!('barangay' in data) || isShortStr(data.barangay)) &&
             (!('Barangay' in data) || isShortStr(data.Barangay)) &&
             (!('year' in data) || data.year == null || (data.year is string && data.year.size() <= 10) || (data.year is int && data.year >= 2000 && data.year <= 2100)) &&
             (!('prefix' in data) || isShortStr(data.prefix)) &&
             (!('updatedAt' in data) || isDateVal(data.updatedAt)) &&
             (!('timestamp' in data) || isDateVal(data.timestamp));
    }

    // ===============================================================
    // 1. Master Collection: youth_profiles
    // ===============================================================
    match /youth_profiles/{profileId} {
      allow read: if isAdmin() || (isApprovedUser() && resource.data.Barangay == userBarangay());

      allow create: if canAccessBarangay(request.resource.data.Barangay) &&
                       isValidYouthProfile(request.resource.data);

      allow update: if canAccessBarangay(resource.data.Barangay) &&
                       canAccessBarangay(request.resource.data.Barangay) &&
                       isValidYouthProfileUpdate(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if canAccessBarangay(resource.data.Barangay);
    }

    // ===============================================================
    // 2. Public Intake Collection: online_submissions (eProfiling)
    // ===============================================================
    match /online_submissions/{submissionId} {
      allow create: if isValidOnlineSubmission(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && isValidOnlineSubmission(request.resource.data);
    }

    // ===============================================================
    // 3. User Accounts Collection: users
    // ===============================================================
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);

      allow create: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       isValidNewUser(request.resource.data, userId);

      allow update: if (isAdmin() && isValidAdminUserUpdate(request.resource.data)) ||
                       (isApprovedUser() &&
                        request.auth.uid == userId &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'fullName', 'displayName', 'contactNumber', 'photoURL', 'updatedAt'
                        ]) &&
                        isValidUserProfileFields(request.resource.data));

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ===============================================================
    // 4. System Audit Trail: audit_logs (Immutable)
    // ===============================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin() || (isApprovedUser() && resource.data.barangay == userBarangay());

      allow create: if canAccessBarangay(request.resource.data.barangay) &&
                       isValidAuditLog(request.resource.data);

      allow update, delete: if false;
    }

    // ===============================================================
    // 5. Sequence Counters: counters
    // ===============================================================
    match /counters/{counterId} {
      allow read: if true;

      allow create: if isValidCounter(request.resource.data) &&
                       request.resource.data.lastSerial >= 0 &&
                       request.resource.data.lastSerial <= 10;

      allow update: if isValidCounter(request.resource.data) &&
                       request.resource.data.lastSerial == resource.data.lastSerial + 1;

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
