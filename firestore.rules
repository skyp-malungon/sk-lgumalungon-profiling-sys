rules_version = '2';

// ===============================================================
// Assumed Data Model (SKYMS - Malungon, Sarangani Province)
// ===============================================================
//
// Collection: youth_profiles
// Document ID: {profileId} (UUID or auto-generated ID)
// Fields:
//   - Barangay: string (required, 1-100 chars) - Assigned Barangay
//   - Full Name: string (required, 1-150 chars) - Youth full name
//   - Timestamp, Date of Birth, Date Accomplished, Date Received, approvedAt, updatedAt, createdAt, submittedAt: timestamp or string (optional, <= 150 chars)
//   - createdBy, updatedBy: string or null (optional, <= 150 chars)
//   - Age: int/float (0-120), string (<= 30 chars), or null (optional)
//   - calculatedAge: int/float (0-120) or null (optional)
//   - Total Household Members: int/float (0-100), string (<= 50 chars), or null (optional)
//   - Multi-select / goals / address strings: string (optional, <= 2000 chars)
//   - Standard survey & system strings: string (optional, <= 500 chars)
//
// Collection: online_submissions
// Document ID: {submissionId} (auto-generated ID)
// Fields:
//   - Barangay / barangay: string (at least one required, 1-100 chars) - Target Barangay
//   - Full Name / fullName: string (at least one required, 1-150 chars) - Applicant full name
//   - Survey fields (TitleCase matching youth_profiles, excluding approvedAt) and camelCase intake keys
//   - Forbidden fields: approvedAt, role, status, isApproved, password, passwordHash
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - uid: string (required on create, == userId, <= 128 chars)
//   - username: string (required on create, 1-100 chars)
//   - email: string (required on create, 1-150 chars)
//   - fullName: string (optional, <= 150 chars)
//   - displayName: string or null (optional, <= 150 chars)
//   - photoURL: string (http/https URL or empty) or null (optional, <= 500 chars)
//   - contactNumber: string or null (optional, <= 50 chars)
//   - role: string (required on create: 'Barangay User'; admin update: 'Admin' or 'Barangay User')
//   - barangay: string (required on create: 1-100 chars, not 'All' or 'System Admin')
//   - status: string (required on create: 'Pending'; admin update: 'Pending'|'Approved'|'Rejected'|'Deactivated')
//   - isApproved: bool (required on create: false)
//   - authProvider: string (required on create: 'google' or 'password')
//   - approvedBy / rejectedBy: string or null (optional, <= 100 chars)
//   - approvedAt / rejectedAt / createdAt / updatedAt: timestamp, string (<= 100 chars), or null (optional)
//   - Forbidden fields: password, passwordHash
//
// Collection: audit_logs (immutable)
// Document ID: {logId} (auto-generated ID)
// Fields:
//   - action: string (required, 1-50 chars)
//   - recordName: string (required, 1-200 chars)
//   - details: string (required, <= 2000 chars)
//   - barangay: string (required, 1-100 chars)
//   - user: string (required, 1-100 chars)
//   - timestamp: timestamp or string (required, 1-100 chars)
//
// Collection: counters
// Document ID: {counterId}
// Fields:
//   - lastSerial: int (required, >= 0)
//   - barangay / Barangay: string (optional, <= 100 chars)
//   - year: int (2000-2100) or string (optional, <= 10 chars)
//   - prefix: string (optional, <= 50 chars)
//   - updatedAt / timestamp: timestamp or string (optional, <= 100 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isAuthenticated() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function isApprovedUser() {
      return userExists() &&
             'status' in userData() &&
             userData().status == 'Approved' &&
             'isApproved' in userData() &&
             userData().isApproved == true;
    }

    function isAdmin() {
      return (isApprovedUser() &&
              'role' in userData() &&
              userData().role == 'Admin') ||
             (isAuthenticated() &&
              'role' in request.auth.token &&
              request.auth.token.role == 'Admin');
    }

    function userBarangay() {
      return userData().barangay;
    }

    function belongsToUserBarangay(brgy) {
      return isAdmin() ||
             (isApprovedUser() &&
              'barangay' in userData() &&
              brgy is string &&
              brgy == userBarangay());
    }

    function isValidUrl(url) {
      return url is string &&
             (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    function isOptionalNullableString(data, key, maxLen) {
      return !(key in data) ||
             data[key] == null ||
             (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalDateOrString(data, key) {
      return !(key in data) ||
             data[key] == null ||
             data[key] is timestamp ||
             (data[key] is string && data[key].size() <= 150);
    }

    function isOptionalPhotoUrl(data, key) {
      return !(key in data) ||
             data[key] == null ||
             data[key] == '' ||
             (isValidUrl(data[key]) && data[key].size() <= 500);
    }

    function isValidNumberRange(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    // ===============================================================
    // Domain Validators (Validator Function Pattern)
    // ===============================================================

    // Shared survey field type & length checks for TitleCase youth profile fields
    function hasValidCommonSurveyFields(data) {
      return isOptionalDateOrString(data, 'Timestamp') &&
             isOptionalNullableString(data, 'FormNo.', 150) &&
             isOptionalNullableString(data, 'Nickname', 150) &&
             isOptionalNullableString(data, 'Sex', 100) &&
             isOptionalDateOrString(data, 'Date of Birth') &&
             (!('Age' in data) ||
              data['Age'] == null ||
              (data['Age'] is string && data['Age'].size() <= 30) ||
              isValidNumberRange(data['Age'], 0, 120)) &&
             (!('calculatedAge' in data) ||
              data.calculatedAge == null ||
              isValidNumberRange(data.calculatedAge, 0, 120)) &&
             isOptionalNullableString(data, 'ageBracket', 50) &&
             isOptionalNullableString(data, 'Place of Birth', 200) &&
             isOptionalNullableString(data, 'Civil Status', 100) &&
             isOptionalNullableString(data, 'Tribe', 150) &&
             isOptionalNullableString(data, 'Citizenship', 150) &&
             isOptionalNullableString(data, 'Religion', 150) &&
             isOptionalNullableString(data, 'Sitio/Purok', 150) &&
             isOptionalNullableString(data, 'Complete Address', 2000) &&
             isOptionalNullableString(data, 'Contact Number', 100) &&
             isOptionalNullableString(data, 'Email Address', 150) &&
             isOptionalNullableString(data, 'Educational Status', 150) &&
             isOptionalNullableString(data, 'Highest Educational Attainment', 150) &&
             isOptionalNullableString(data, 'School/Institution', 250) &&
             isOptionalNullableString(data, 'Course/Strand', 200) &&
             isOptionalNullableString(data, 'Employment Status', 150) &&
             isOptionalNullableString(data, 'Nature of Work', 200) &&
             isOptionalNullableString(data, 'Skills/Talents', 2000) &&
             isOptionalNullableString(data, 'Languages Spoken', 2000) &&
             isOptionalNullableString(data, 'Member of Youth Organization', 200) &&
             isOptionalNullableString(data, 'Organizations', 2000) &&
             isOptionalNullableString(data, 'Leadership Position', 2000) &&
             isOptionalNullableString(data, 'Volunteer Activities', 2000) &&
             isOptionalNullableString(data, 'Areas of Interest', 2000) &&
             isOptionalNullableString(data, 'Youth Sector', 2000) &&
             (!('Total Household Members' in data) ||
              data['Total Household Members'] == null ||
              (data['Total Household Members'] is string && data['Total Household Members'].size() <= 50) ||
              isValidNumberRange(data['Total Household Members'], 0, 100)) &&
             isOptionalNullableString(data, 'Household Income', 150) &&
             isOptionalNullableString(data, 'Internet Access', 100) &&
             isOptionalNullableString(data, 'Internet Connection Type', 150) &&
             isOptionalNullableString(data, 'Preferred Announcement Mode', 2000) &&
             isOptionalNullableString(data, '5-Year Goals', 2000) &&
             isOptionalNullableString(data, 'Desired Programs', 2000) &&
             isOptionalNullableString(data, 'Participation Mode', 2000) &&
             isOptionalNullableString(data, 'Data Consent', 500) &&
             isOptionalDateOrString(data, 'Date Accomplished') &&
             isOptionalNullableString(data, 'SK Data Collector', 200) &&
             isOptionalDateOrString(data, 'Date Received') &&
             isOptionalNullableString(data, 'uid', 128) &&
             isOptionalDateOrString(data, 'updatedAt');
    }

    function isValidYouthProfile(data) {
      return data.keys().hasOnly([
               'Timestamp', 'FormNo.', 'Barangay', 'Full Name', 'Nickname', 'Sex',
               'Date of Birth', 'Age', 'calculatedAge', 'ageBracket', 'Place of Birth',
               'Civil Status', 'Tribe', 'Citizenship', 'Religion', 'Sitio/Purok',
               'Complete Address', 'Contact Number', 'Email Address', 'Educational Status',
               'Highest Educational Attainment', 'School/Institution', 'Course/Strand',
               'Employment Status', 'Nature of Work', 'Skills/Talents', 'Languages Spoken',
               'Member of Youth Organization', 'Organizations', 'Leadership Position',
               'Volunteer Activities', 'Areas of Interest', 'Youth Sector',
               'Total Household Members', 'Household Income', 'Internet Access',
               'Internet Connection Type', 'Preferred Announcement Mode', '5-Year Goals',
               'Desired Programs', 'Participation Mode', 'Data Consent',
               'Date Accomplished', 'SK Data Collector', 'Date Received',
               'uid', 'approvedAt', 'updatedAt',
               'createdAt', 'submittedAt', 'createdBy', 'updatedBy'
             ]) &&
             'Barangay' in data &&
             data['Barangay'] is string &&
             data['Barangay'].size() > 0 &&
             data['Barangay'].size() <= 100 &&
             'Full Name' in data &&
             data['Full Name'] is string &&
             data['Full Name'].size() > 0 &&
             data['Full Name'].size() <= 150 &&
             isOptionalDateOrString(data, 'approvedAt') &&
             isOptionalDateOrString(data, 'createdAt') &&
             isOptionalDateOrString(data, 'submittedAt') &&
             isOptionalNullableString(data, 'createdBy', 150) &&
             isOptionalNullableString(data, 'updatedBy', 150) &&
             hasValidCommonSurveyFields(data);
    }

    function isValidOnlineSubmission(data) {
      return !data.keys().hasAny([
               'approvedAt', 'role', 'status', 'isApproved', 'password', 'passwordHash'
             ]) &&
             data.keys().hasOnly([
               'Timestamp', 'FormNo.', 'Barangay', 'Full Name', 'Nickname', 'Sex',
               'Date of Birth', 'Age', 'calculatedAge', 'ageBracket', 'Place of Birth',
               'Civil Status', 'Tribe', 'Citizenship', 'Religion', 'Sitio/Purok',
               'Complete Address', 'Contact Number', 'Email Address', 'Educational Status',
               'Highest Educational Attainment', 'School/Institution', 'Course/Strand',
               'Employment Status', 'Nature of Work', 'Skills/Talents', 'Languages Spoken',
               'Member of Youth Organization', 'Organizations', 'Leadership Position',
               'Volunteer Activities', 'Areas of Interest', 'Youth Sector',
               'Total Household Members', 'Household Income', 'Internet Access',
               'Internet Connection Type', 'Preferred Announcement Mode', '5-Year Goals',
               'Desired Programs', 'Participation Mode', 'Data Consent',
               'Date Accomplished', 'SK Data Collector', 'Date Received',
               'uid', 'updatedAt',
               'barangay', 'fullName', 'contactNumber', 'sitio', 'dateOfBirth',
               'sex', 'civilStatus', 'tribe', 'educationalStatus',
               'highestEducationalAttainment', 'employmentStatus', 'youthSector',
               'formNo', 'createdAt', 'submittedAt'
             ]) &&
             (('Barangay' in data && data['Barangay'] is string && data['Barangay'].size() > 0 && data['Barangay'].size() <= 100) ||
              ('barangay' in data && data.barangay is string && data.barangay.size() > 0 && data.barangay.size() <= 100)) &&
             (!('Barangay' in data) || (data['Barangay'] is string && data['Barangay'].size() > 0 && data['Barangay'].size() <= 100)) &&
             (!('barangay' in data) || (data.barangay is string && data.barangay.size() > 0 && data.barangay.size() <= 100)) &&
             (('Full Name' in data && data['Full Name'] is string && data['Full Name'].size() > 0 && data['Full Name'].size() <= 150) ||
              ('fullName' in data && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150)) &&
             (!('Full Name' in data) || (data['Full Name'] is string && data['Full Name'].size() > 0 && data['Full Name'].size() <= 150)) &&
             (!('fullName' in data) || (data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150)) &&
             hasValidCommonSurveyFields(data) &&
             isOptionalNullableString(data, 'contactNumber', 50) &&
             isOptionalNullableString(data, 'sitio', 150) &&
             isOptionalDateOrString(data, 'dateOfBirth') &&
             isOptionalNullableString(data, 'sex', 50) &&
             isOptionalNullableString(data, 'civilStatus', 50) &&
             isOptionalNullableString(data, 'tribe', 100) &&
             isOptionalNullableString(data, 'educationalStatus', 150) &&
             isOptionalNullableString(data, 'highestEducationalAttainment', 150) &&
             isOptionalNullableString(data, 'employmentStatus', 150) &&
             isOptionalNullableString(data, 'youthSector', 2000) &&
             isOptionalNullableString(data, 'formNo', 100) &&
             isOptionalDateOrString(data, 'createdAt') &&
             isOptionalDateOrString(data, 'submittedAt');
    }

    function isValidUserProfileFields(data) {
      return isOptionalNullableString(data, 'fullName', 150) &&
             isOptionalNullableString(data, 'displayName', 150) &&
             isOptionalNullableString(data, 'contactNumber', 50) &&
             isOptionalPhotoUrl(data, 'photoURL') &&
             isOptionalDateOrString(data, 'updatedAt');
    }

    function isValidNewUser(data, userId) {
      return data.keys().hasOnly([
               'uid', 'username', 'email', 'fullName', 'displayName', 'photoURL',
               'contactNumber', 'role', 'barangay', 'status', 'isApproved',
               'authProvider', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasAll([
               'uid', 'username', 'email', 'role', 'barangay',
               'status', 'isApproved', 'authProvider'
             ]) &&
             data.uid is string &&
             data.uid == userId &&
             data.uid.size() <= 128 &&
             data.username is string &&
             data.username.size() > 0 &&
             data.username.size() <= 100 &&
             data.email is string &&
             data.email.size() > 0 &&
             data.email.size() <= 150 &&
             data.role == 'Barangay User' &&
             data.status == 'Pending' &&
             data.isApproved == false &&
             data.barangay is string &&
             data.barangay.size() > 0 &&
             data.barangay.size() <= 100 &&
             data.barangay != 'All' &&
             data.barangay != 'System Admin' &&
             data.authProvider in ['google', 'password'] &&
             isValidUserProfileFields(data) &&
             isOptionalDateOrString(data, 'createdAt');
    }

    function isValidAdminUserUpdate(data) {
      return !data.keys().hasAny(['password', 'passwordHash']) &&
             data.keys().hasOnly([
               'uid', 'username', 'email', 'fullName', 'displayName', 'photoURL',
               'contactNumber', 'role', 'barangay', 'status', 'isApproved',
               'authProvider', 'approvedBy', 'approvedAt', 'rejectedBy',
               'rejectedAt', 'createdAt', 'updatedAt'
             ]) &&
             (!('uid' in data) || (data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128)) &&
             (!('uid' in resource.data) || !('uid' in data) || data.uid == resource.data.uid) &&
             (!('username' in data) || (data.username is string && data.username.size() > 0 && data.username.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() > 0 && data.email.size() <= 150)) &&
             (!('role' in data) || data.role in ['Admin', 'Barangay User']) &&
             (!('status' in data) || data.status in ['Pending', 'Approved', 'Rejected', 'Deactivated']) &&
             (!('isApproved' in data) || data.isApproved is bool) &&
             (!('barangay' in data) || (data.barangay is string && data.barangay.size() > 0 && data.barangay.size() <= 100)) &&
             (!('authProvider' in data) || data.authProvider in ['google', 'password']) &&
             isOptionalNullableString(data, 'approvedBy', 100) &&
             isOptionalDateOrString(data, 'approvedAt') &&
             isOptionalNullableString(data, 'rejectedBy', 100) &&
             isOptionalDateOrString(data, 'rejectedAt') &&
             isOptionalDateOrString(data, 'createdAt') &&
             (!('createdAt' in resource.data) || !('createdAt' in data) || data.createdAt == resource.data.createdAt) &&
             isValidUserProfileFields(data);
    }

    function isValidAuditLog(data) {
      return data.keys().hasOnly([
               'action', 'recordName', 'details', 'barangay', 'user', 'timestamp'
             ]) &&
             data.keys().hasAll([
               'action', 'recordName', 'details', 'barangay', 'user', 'timestamp'
             ]) &&
             data.action is string &&
             data.action.size() > 0 &&
             data.action.size() <= 50 &&
             data.recordName is string &&
             data.recordName.size() > 0 &&
             data.recordName.size() <= 200 &&
             data.details is string &&
             data.details.size() <= 2000 &&
             data.barangay is string &&
             data.barangay.size() > 0 &&
             data.barangay.size() <= 100 &&
             data.user is string &&
             data.user.size() > 0 &&
             data.user.size() <= 100 &&
             (data.timestamp is timestamp ||
              (data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 100));
    }

    function isValidCounter(data) {
      return data.keys().hasOnly([
               'lastSerial', 'barangay', 'Barangay', 'year', 'prefix', 'updatedAt', 'timestamp'
             ]) &&
             'lastSerial' in data &&
             data.lastSerial is int &&
             data.lastSerial >= 0 &&
             isOptionalNullableString(data, 'barangay', 100) &&
             isOptionalNullableString(data, 'Barangay', 100) &&
             (!('year' in data) ||
              data.year == null ||
              (data.year is string && data.year.size() <= 10) ||
              (data.year is int && data.year >= 2000 && data.year <= 2100)) &&
             isOptionalNullableString(data, 'prefix', 50) &&
             isOptionalDateOrString(data, 'updatedAt') &&
             isOptionalDateOrString(data, 'timestamp');
    }

    // ===============================================================
    // 1. Master Collection: youth_profiles
    // ===============================================================
    match /youth_profiles/{profileId} {
      allow read: if isAdmin() ||
                     (isApprovedUser() &&
                      'barangay' in userData() &&
                      resource.data.Barangay == userBarangay());

      allow create: if isApprovedUser() &&
                       isValidYouthProfile(request.resource.data) &&
                       belongsToUserBarangay(request.resource.data.Barangay);

      allow update: if isApprovedUser() &&
                       isValidYouthProfile(request.resource.data) &&
                       belongsToUserBarangay(resource.data.Barangay) &&
                       belongsToUserBarangay(request.resource.data.Barangay);

      allow delete: if isApprovedUser() &&
                       belongsToUserBarangay(resource.data.Barangay);
    }

    // ===============================================================
    // 2. Public Intake Collection: online_submissions (eProfiling)
    // ===============================================================
    match /online_submissions/{submissionId} {
      allow create: if isValidOnlineSubmission(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && isValidOnlineSubmission(request.resource.data);
    }

    // ===============================================================
    // 3. User Profiles Collection: users
    // ===============================================================
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);

      allow create: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       isValidNewUser(request.resource.data, userId);

      allow update: if (isAdmin() && isValidAdminUserUpdate(request.resource.data)) ||
                       (isApprovedUser() &&
                        request.auth.uid == userId &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'fullName', 'displayName', 'contactNumber', 'photoURL', 'updatedAt'
                        ]) &&
                        isValidUserProfileFields(request.resource.data));

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ===============================================================
    // 4. System Audit Trail: audit_logs (Immutable)
    // ===============================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin() ||
                     (isApprovedUser() &&
                      'barangay' in userData() &&
                      resource.data.barangay == userBarangay());

      allow create: if isApprovedUser() &&
                       isValidAuditLog(request.resource.data) &&
                       belongsToUserBarangay(request.resource.data.barangay);

      allow update, delete: if false;
    }

    // ===============================================================
    // 5. Atomic Sequence Counters: counters
    // ===============================================================
    match /counters/{counterId} {
      // Sequence numbers only (no PII); needed by public intake form (prof.js)
      allow read: if true;

      allow create: if isValidCounter(request.resource.data) &&
                       request.resource.data.lastSerial >= 0 &&
                       request.resource.data.lastSerial <= 10;

      allow update: if isValidCounter(request.resource.data) &&
                       request.resource.data.lastSerial == resource.data.lastSerial + 1;

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Default Deny Rule
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
